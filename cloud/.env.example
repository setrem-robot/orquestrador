# ============================================================
# Variáveis do ambiente Cloud. Copie para ".env" (mesma pasta) e preencha.
# O .env NÃO vai para o git (está no .gitignore).
#   cp .env.example .env
# ============================================================

# --- Broker MQTT remoto ---
# Usuário/senha que o ingestor usa para assinar a telemetria. Use o MESMO par
# criado no arquivo passwd (ver scripts/gen-mosquitto-passwd.sh) — pode ser o
# próprio usuário da bridge do Pi.
MQTT_USERNAME=piev
MQTT_PASSWORD=troque-esta-senha

# --- TimescaleDB ---
PGUSER=robo
PGPASSWORD=troque-esta-senha
PGDATABASE=robo

# --- API de leitura (o app e a landing page) ---
# Token que o app manda em `Authorization: Bearer <token>`. Gere um comprido e
# aleatório — ele dá acesso a TODO o histórico, inclusive às coordenadas exatas:
#   openssl rand -hex 32
API_TOKEN=troque-por-um-token-aleatorio-longo

# Usuário do banco só de leitura, usado pela API. Criá-lo é um comando SQL
# (ver docs/setup-cloud.md): um bug numa rota não pode apagar histórico.
API_PGUSER=robo_leitura
API_PGPASSWORD=troque-esta-senha

# Origens da landing page, separadas por vírgula. Vazio = nenhum navegador
# consegue chamar a API (o app não é navegador e não depende disto).
#   CORS_ORIGENS=https://atlas.seudominio.com.br
CORS_ORIGENS=

# Rotas sem token, para a landing page. Servem menos de propósito: só o resumo
# e o trajeto com a precisão reduzida. `false` desliga por inteiro.
PUBLICO_HABILITADO=true
# Casas decimais das coordenadas públicas. 4 dão ~11 m: dá para ver o robô
# andando pelo campus, não dá para saber em que sala ele está. 0 desliga.
PRECISAO_GPS_PUBLICA=4

# --- Túnel da Cloudflare ---
# Criado em: Zero Trust -> Networks -> Tunnels -> Create a tunnel (Cloudflared).
# Copie o token que o painel mostra. Ver docs/setup-cloud.md.
TUNNEL_TOKEN=
