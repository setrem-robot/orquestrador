# ============================================================
# Ambiente de TESTES, na sua máquina. Copie para `.env`:
#
#   cp .env.local.example .env
#
# Já vem preenchido e funcionando: nenhum campo precisa ser inventado antes da
# primeira subida. É o oposto do `.env.example`, que é o da VM e deixa as
# senhas em branco de propósito — lá, um valor padrão esquecido no arquivo é
# uma senha padrão em produção.
#
# ⚠️  As senhas abaixo são públicas: estão num arquivo versionado, no GitHub.
#     Servem para um banco que só a sua máquina alcança. Ao migrar para o
#     LARCC, gere outras — `docs/ambiente-local.md` explica quais e como.
# ============================================================

# --- Broker MQTT ---
# Vazios de propósito: o broker local (`mosquitto.local.conf`) aceita conexão
# sem senha, e o ingestor pula a autenticação quando não há usuário.
MQTT_USERNAME=
MQTT_PASSWORD=

# --- TimescaleDB ---
PGUSER=robo
PGPASSWORD=senha-de-teste-local
PGDATABASE=robo

# --- API ---
# Em que endereço a API escuta. `0.0.0.0` é o que faz o celular alcançar esta
# máquina; na VM fica `127.0.0.1`, porque lá quem publica na internet é o túnel
# da Cloudflare, e a porta não deve ficar aberta na rede da faculdade.
API_BIND=0.0.0.0

# Token de teste. Legível, para você conseguir digitá-lo no celular sem errar —
# na VM ele vira 64 caracteres aleatórios (`openssl rand -hex 32`).
API_TOKEN=atlas-token-de-teste-local

API_PGUSER=robo_leitura
API_PGPASSWORD=leitura-de-teste-local

# `compose.local.yml` sobrescreve isto com `*`, porque em desenvolvimento a
# landing page é servida de onde der na hora.
CORS_ORIGENS=

PUBLICO_HABILITADO=true
PRECISAO_GPS_PUBLICA=4

# --- Túnel da Cloudflare ---
# Vazio aqui: não há domínio apontando para a sua máquina, e o `cloudflared`
# nem sobe sem o perfil `tunel`. Preencher isto é um dos dois passos da
# migração para a VM.
TUNNEL_TOKEN=
